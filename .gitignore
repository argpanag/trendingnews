# Only track generated static files
*.html
*.css
*.js
*.svg
*.png
*.jpg
*.gif
*.ico
sitemap.xml
robots.txt

# Ignore everything else
*

# Exception: allow root level generated files
!/*.html
!/*.css
!/*.js
!/*.svg
!/*.png
!/*.jpg
!/*.gif
!/*.ico
!/sitemap.xml
!/robots.txt

# Allow directories that contain generated content
!articles/
!archive/
